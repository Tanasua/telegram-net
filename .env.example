# Скопіюй у .env і заповни. Нічого з цього не вигадуй — реальні значення тільки від тебе.

# --- Telegram: публікація постів (один бот, доданий адміном у всі 23 канали) ---
TELEGRAM_BOT_TOKEN=

# --- Telegram: читання чужих публічних каналів-джерел (MTProto-юзерсесія, Telethon) ---
# Отримати на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_net_reader

# --- OpenAI ---
OPENAI_API_KEY=
# Перевір актуальні назви моделей на platform.openai.com/docs/models — тут навмисно
# немає значення "за замовчуванням", бо на момент написання коду я не мав 100% точного
# підтвердження поточної лінійки моделей (див. README).
OPENAI_CLASSIFIER_MODEL=
OPENAI_GENERATOR_MODEL=

# --- Google Sheets (конфіг-шар) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=./credentials/service_account.json

# --- База стану ---
DATABASE_URL=sqlite:///telegram_net.db
